---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Descubra os melhores artigos religiosos, terços, escapulários e imagens sacras na Entre Ave Marias.", 
  image = "/logotipo.png" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://www.lojaentreavemarias.com.br");
const socialImageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logotipo.png" />
    <title>{title}</title>
    
    <!-- Meta Tags para SEO e Redes Sociais (WhatsApp / Facebook) -->
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />
    
    <main>
      <slot />
    </main>

    <Footer />
    <CartDrawer />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const syncButtonsState = () => {
          try {
            const favs = JSON.parse(localStorage.getItem('favorites') || '[]');
            const favoriteButtons = document.querySelectorAll('.btn-favorite');
            favoriteButtons.forEach(btn => {
              const id = btn.getAttribute('data-id');
              if (favs.some(item => item.id === id)) {
                btn.classList.add('active');
              } else {
                btn.classList.remove('active');
              }
            });
          } catch (e) {
            console.error('Erro ao sincronizar favoritos:', e);
          }
        };

        syncButtonsState();

        document.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.btn-favorite');
          if (!btn) return;

          e.preventDefault();
          
          const id = btn.getAttribute('data-id');
          const name = btn.getAttribute('data-name');
          const price = parseFloat(btn.getAttribute('data-price') || '0');
          const image = btn.getAttribute('data-image');

          if (!id) return;

          let favs = [];
          try {
            favs = JSON.parse(localStorage.getItem('favorites') || '[]');
          } catch (err) {
            favs = [];
          }

          const index = favs.findIndex(item => item.id === id);
          if (index > -1) {
            favs.splice(index, 1);
          } else {
            favs.push({ id, name, price, image });
          }

          localStorage.setItem('favorites', JSON.stringify(favs));
          syncButtonsState();

            if (typeof (window as any).updateFavoritesUI === 'function') {
            (window as any).updateFavoritesUI();
          } else {
            window.dispatchEvent(new CustomEvent('favoritesUpdated'));
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --primary-green: #2d4a3e;
    --primary-green-dark: #1e332a;
    --gold: #d4af37;
    --gold-dark: #b89728;
    --white: #ffffff;
    --bg-light: #fbf9f4;
    --text-dark: #333333;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--text-dark);
    background-color: var(--bg-light);
    line-height: 1.5;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Playfair Display', serif;
  }

  #cart-items-container img, 
  #favorites-items-container img,
  .side-drawer img {
    width: 60px !important;
    height: 60px !important;
    min-width: 60px !important;
    max-width: 60px !important;
    min-height: 60px !important;
    max-height: 60px !important;
    object-fit: cover !important;
    border-radius: 6px !important;
    border: 1px solid #ddd !important;
    display: block !important;
    flex-shrink: 0 !important;
  }
</style>