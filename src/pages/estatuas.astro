---

<Layout title="Estátuas e Imagens | Entre Ave-Marias">
  <main class="catalog-page">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Início</a> &gt; <span>Estátuas</span>
      </div>

      <div class="page-header">
        <h1>Estátuas e Imagens Sagradas</h1>
        <p>Imagens cheias de beleza e significado para consagrar o seu lar e momentos de oração.</p>
      </div>

      <div class="products-grid">
        {estatuas.map((estatua) => {
          const whatsappMessage = encodeURIComponent(`Olá! Gostaria de encomendar a ${estatua.nome}. Poderia me informar valores, disponibilidade e formas de envio?`);
          return (
            <div class="product-card">
              <div class="product-image-wrapper">
                <button 
                  type="button" 
                  class="btn-favorite" 
                  data-id={estatua.id}
                  data-name={estatua.nome}
                  data-price={estatua.preco}
                  data-image={estatua.imagem}
                  aria-label="Adicionar aos favoritos"
                >
                  ❤️
                </button>

                <div class="clickable-img" data-img={estatua.imagem} style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                  <img src={estatua.imagem} alt={estatua.nome} />
                  <span class="zoom-hint">🔍 Clique para ampliar</span>
                </div>
              </div>

              <div class="product-info">
                <div>
                  <h2>{estatua.nome}</h2>
                  <p class="product-price">R$ {estatua.preco.toFixed(2)}</p>
                  <p class="product-description" style="white-space: pre-line;">{estatua.descricao}</p>
                  
                  <p class="section-title">Detalhes do produto:</p>
                  <ul class="product-details">
                    {estatua.detalhes.map((detalhe) => (
                      <li>{detalhe}</li>
                    ))}
                  </ul>

                  <p class="product-gift" style="white-space: pre-line;">{estatua.sugestao}</p>
                </div>

                <div class="product-actions">
                  <button 
                    type="button" 
                    class="btn-cart"
                    onclick={`window.addToCart({
                      id: '${estatua.id}',
                      name: '${estatua.nome.replace(/'/g, "\\'")}',
                      price: ${estatua.preco},
                      image: '${estatua.imagem}'
                    })`}
                  >
                    Adicionar ao Carrinho 🛒
                  </button>

                  <a 
                    href={`https://wa.me/5511932189878?text=${whatsappMessage}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn-order"
                  >
                    Fazer Encomenda
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="other-collections">
        <h2>Explore Outras Coleções</h2>
        <div class="collections-links">
          <a href="/tercos">📿 Terços</a>
          <a href="/camisetas">👕 Camisetas</a>
          <a href="/artigos">🎨 Artigos</a>
        </div>
      </div>
    </div>
  </main>

  <div id="imageModal" class="modal">
    <span class="close-modal">&times;</span>
    <img class="modal-content" id="img01" alt="Imagem ampliada" />
  </div>

  <WhatsAppButton />
</Layout>

<script>
  window.addToCart = window.handleAddToCart = function(product) {
    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem('cart') || '[]');
    } catch (e) {
      cart = [];
    }

    const existingIndex = cart.findIndex(item => item.id === product.id);
    if (existingIndex > -1) {
      cart[existingIndex].quantity = (Number(cart[existingIndex].quantity) || 1) + 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }

    localStorage.setItem('cart', JSON.stringify(cart));
    
    if (typeof window.updateCartUI === 'function') {
      window.updateCartUI();
    }
    
    document.getElementById('cart-drawer')?.classList.add('open');
    document.getElementById('drawer-overlay')?.classList.add('open');
  };

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.btn-favorite');
    if (!btn) return;

    const product = {
      id: btn.getAttribute('data-id'),
      name: btn.getAttribute('data-name'),
      price: Number(btn.getAttribute('data-price')),
      image: btn.getAttribute('data-image')
    };

    let favs = [];
    try {
      favs = JSON.parse(localStorage.getItem('favorites') || '[]');
    } catch (err) {
      favs = [];
    }

    const index = favs.findIndex(item => item.id === product.id);
    if (index > -1) {
      favs.splice(index, 1);
    } else {
      favs.push(product);
    }
    localStorage.setItem('favorites', JSON.stringify(favs));

    syncFavoriteButtons();
    window.dispatchEvent(new CustomEvent('favoritesUpdated'));
  });

  function syncFavoriteButtons() {
    try {
      const favs = JSON.parse(localStorage.getItem('favorites') || '[]');
      document.querySelectorAll('.btn-favorite').forEach(btn => {
        const id = btn.getAttribute('data-id');
        const isFav = favs.some(fav => fav.id === id);
        if (isFav) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    } catch (e) {
      console.error('Erro ao sincronizar favoritos:', e);
    }
  }

  document.addEventListener('DOMContentLoaded', syncFavoriteButtons);
  window.addEventListener('favoritesUpdated', syncFavoriteButtons);

  const modal = document.getElementById('imageModal');
  const modalImg = document.getElementById('img01');
  const closeBtn = document.getElementsByClassName('close-modal')[0];
  const clickableImages = document.querySelectorAll('.clickable-img');

  clickableImages.forEach((wrapper) => {
    wrapper.addEventListener('click', () => {
      const imgSrc = wrapper.getAttribute('data-img');
      if (modal && modalImg && imgSrc) {
        modal.style.display = 'flex';
        modalImg.src = imgSrc;
      }
    });
  });

  if (closeBtn && modal) {
    closeBtn.onclick = () => {
      modal.style.display = 'none';
    };
  }

  if (modal) {
    modal.onclick = (e) => {
      if (e.target === modal) {
        modal.style.display = 'none';
      }
    };
  }
</script>

<style>
