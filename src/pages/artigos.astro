    color: #555;
    font-size: 16px;
  }
  .products-grid {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .product-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid #eee;
  }
  @media(min-width: 768px) {
    .product-card {
      flex-direction: row;
    }
  }

  .product-image-wrapper {
    flex: 1;
    min-height: 380px;
    overflow: hidden;
    background-color: #f5f3ed;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .btn-favorite {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.2s, background 0.2s;
  }
  .btn-favorite:hover {
    transform: scale(1.1);
    background: #fff5f5;
  }
  .btn-favorite.active {
    background: #ffe6e6;
    border-color: #ff4d4d;
  }

  .zoom-hint {
    position: absolute;
    bottom: 10px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-image-wrapper:hover .zoom-hint {
    opacity: 1;
  }

  .product-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
    cursor: pointer;
  }

  .product-card:hover .product-image-wrapper img {
    transform: scale(1.05);
  }

  .product-info {
    flex: 1;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .product-info h2 {
    font-size: 24px;
    color: var(--primary-green, #2d4a3e);
    margin-bottom: 6px;
  }
  .product-price {
    font-size: 20px;
    font-weight: 700;
    color: var(--gold, #d4af37);
    margin-bottom: 12px;
  }
  .product-description {
    font-size: 14px;
    color: #444;
    line-height: 1.6;
    margin-bottom: 15px;
  }
  .section-title {
    font-size: 13px;
    font-weight: bold;
    color: var(--primary-green, #2d4a3e);
    margin-bottom: 6px;
  }
  .product-details {
    font-size: 13px;
    color: #666;
    margin-bottom: 15px;
    padding-left: 18px;
    line-height: 1.5;
  }
  .product-details li {
    margin-bottom: 4px;
  }
  .product-gift {
    font-size: 13px;
    color: #444;
    line-height: 1.5;
    margin-bottom: 20px;
    font-style: italic;
  }

  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn-cart {
    display: block;
    text-align: center;
    background-color: var(--primary-green, #2d4a3e);
    color: #fff;
    padding: 12px;
    border-radius: 8px;
    border: none;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s;
  }
  .btn-cart:hover {
    background-color: var(--primary-green-dark, #1e332a);
  }

  .btn-order {
    background-color: var(--gold, #d4af37);
    color: #fff;
    padding: 12px;
    border-radius: 8px;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s;
    display: block;
  }
  .btn-order:hover {
    background-color: var(--gold-dark, #b89728);
  }

  .other-collections {
    margin-top: 60px;
    text-align: center;
  }
  .other-collections h2 {
    font-size: 28px;
    color: var(--primary-green, #2d4a3e);
    margin-bottom: 25px;
  }
  .collections-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }
  .collections-links a {
    background: #fff;
    border: 1px solid #ddd;
    padding: 12px 24px;
    border-radius: 30px;
    text-decoration: none;
    color: var(--primary-green, #2d4a3e);
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    transition: all 0.3s;
  }
  .collections-links a:hover {
    background: var(--primary-green, #2d4a3e);
    color: #fff;
    border-color: var(--primary-green, #2d4a3e);
    transform: translateY(-2px);
  }

  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .modal-content {
    max-width: 90%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 5px 30px rgba(0,0,0,0.5);
  }
  .close-modal {
    position: absolute;
    top: 20px;
    right: 35px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
  }
  .close-modal:hover {
    color: #d4af37;
  }
</style>