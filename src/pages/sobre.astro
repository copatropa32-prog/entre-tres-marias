---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Quem Somos | Entre Ave-Marias">
  <Header />

  <main class="about-page">
    <div class="container">
      <div class="about-content">
        <div class="about-image-card">
          <img src="/quem-somos.webp" alt="Quem Somos - Entre Ave-Marias" />
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .about-page {
    padding: 60px 20px;
    background-color: var(--bg-light, #fbf9f4);
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .container {
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }
  .about-content {
    display: flex;
    justify-content: center;
  }
  .about-image-card {
    background: #fff;
    padding: 15px;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    border: 1px solid #eae1d0;
    max-width: 550px;
    width: 100%;
    transition: transform 0.3s ease;
  }
  .about-image-card:hover {
    transform: translateY(-4px);
  }
  .about-image-card img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
  }
</style>