---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Quem Somos | Entre Ave-Marias">
  <section class="about-container">
    <div class="about-image-card">
      <img src="/sobre-nos.webp" alt="Quem Somos - Entre Ave-Marias" />
    </div>

    <div class="actions">
      <a href="https://wa.me/5511932189878" class="btn-primary" target="_blank">Fale Conosco pelo WhatsApp</a>
    </div>
  </section>
</Layout>

<style>
  .about-container {
    max-width: 650px;
    margin: 60px auto;
    padding: 0 20px;
    text-align: center;
  }

  .about-image-card {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    margin-bottom: 30px;
    background-color: var(--white);
  }

  .about-image-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  .actions {
    margin-top: 20px;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--gold);
    color: var(--white);
    padding: 12px 30px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.3s;
  }

  .btn-primary:hover {
    background-color: var(--gold-dark);
  }
</style>