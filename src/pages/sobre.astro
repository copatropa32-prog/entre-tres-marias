---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Quem Somos - Entre Ave-Marias">
  <main class="about-container">
    <div class="about-card">
      <div class="about-image-wrapper">
        <img src="/quem-somos.webp" alt="Quem Somos - Entre Ave-Marias" class="about-img" />
      </div>

      <div class="about-footer">
        <a href="/" class="btn-home">Voltar para a Página Inicial</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .about-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 85vh;
    background-color: #fcfbfa;
    padding: 30px 20px;
    font-family: sans-serif;
  }
  .about-card {
    background: #fff;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 4px 25px rgba(0,0,0,0.05);
    width: 100%;
    max-width: 550px;
    border: 1px solid #eae1d0;
    text-align: center;
  }
  .about-image-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }
  .about-img {
    width: 100%;
    max-width: 480px;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    object-fit: cover;
    border: 1px solid #f2eedb;
  }
  .about-footer {
    padding-top: 15px;
  }
  .btn-home {
    display: inline-block;
    background-color: #2d4a3e;
    color: white;
    text-decoration: none;
    padding: 10px 24px;
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    transition: background 0.2s;
  }
  .btn-home:hover {
    background-color: #1f332a;
  }
</style>