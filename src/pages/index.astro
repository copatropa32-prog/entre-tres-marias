---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductCard from '../components/ProductCard.astro';

// Produtos em destaque apontando para as páginas de categoria com âncoras para o ID exato
const produtosDestaque = [
  {
    id: 'estatua-sagrada-familia',
    name: 'Estátua da Sagrada Família',
    price: 119.90,
    image: '/a-sagrada-familia.jpg',
    category: 'Estátuas',
    link: '/estatuas#estatua-sagrada-familia'
  },
  {
    id: 'terco-01',
    name: 'Terço de Pérolas Brancas com Crucifixo Dourado',
    price: 89.90,
    image: '/terco-perolas-brancas.jpg',
    category: 'Terços',
    link: '/tercos#terco-01'
  },
  {
    id: 'luminaria-nossa-senhora-aparecida',
    name: 'Luminária Esfera de Nossa Senhora Aparecida',
    price: 99.90,
    image: '/luminarias.webp',
    category: 'Estátuas',
    link: '/estatuas#luminaria-nossa-senhora-aparecida'
  },
  {
    id: 'camiseta-nossa-senhora',
    name: 'Camiseta Nossa Senhora – Cuida do Meu Coração',
    price: 59.90,
    image: '/camiseta.crista.jpg',
    category: 'Camisetas',
    link: '/camisetas#camiseta-nossa-senhora'
  }
];
---

<Layout title="Entre Ave-Marias | Artigos Religiosos Exclusivos">
  <!-- Gaveta do Carrinho e Favoritos -->
  <CartDrawer />

  <main>
    <!-- Seção Principal (Hero com Mosaico Sofisticado) -->
    <section class="hero-section">
      <div class="hero-bg-collage">
        <div class="hero-bg-item bg-sagrada-familia"></div>
        <div class="hero-bg-item bg-cruz"></div>
        <div class="hero-bg-item bg-pulseira"></div>
      </div>

      <div class="hero-container">
        <span class="hero-subtitle">✨ COLEÇÃO EXCLUSIVA E ARTESANAL</span>
        <h1>Fé que toca a alma</h1>
        <p>Cada peça feita à mão, um reflexo de devoção e exclusividade para o seu lar.</p>
        <div class="hero-actions">
          <a href="#destaques" class="btn-hero">Ver Destaques</a>
          <a href="#colecoes" class="btn-hero-outline">Explorar Coleções</a>
        </div>
      </div>
    </section>

    <!-- Barra de Benefícios / Prova Social -->
    <section class="benefits-bar">
      <div class="benefits-container">
        <div class="benefit-item">
          <span class="benefit-icon">🤲</span>
          <div>
            <h4>Feito à Mão</h4>
            <p>Exclusividade e cuidado em cada detalhe</p>
          </div>
        </div>
        <div class="benefit-item">
          <span class="benefit-icon">🚚</span>
          <div>
            <h4>Frete Especial</h4>
            <p>Grátis para São Bernardo do Campo (acima de R$ 150)</p>
          </div>
        </div>
        <div class="benefit-item">
          <span class="benefit-icon">🛡️</span>
          <div>
            <h4>Compra Segura</h4>
            <p>Atendimento humanizado via WhatsApp</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Seção de Produtos em Destaque -->
    <section id="destaques" class="featured-section">
      <div class="container">
        <span class="section-tag">OS MAIS DESEJADOS</span>
        <h2>Destaques da Semana</h2>
        <p class="section-description">Adicione ao carrinho ou salve nos favoritos com apenas um clique.</p>
        
        <div class="products-grid">
          {produtosDestaque.map(prod => (
            <div class="featured-card-wrapper">
              <a href={prod.link} class="featured-image-link">
                <ProductCard 
                  id={prod.id}
                  name={prod.name}
                  price={prod.price}
                  image={prod.image}
                  category={prod.category}
                />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Seção de Coleções / Categorias -->
    <section id="colecoes" class="collections-section">
      <div class="container">
        <h2>Nossas Coleções</h2>
        <div class="collections-grid">
          
          <a href="/tercos" class="collection-card">
            <div class="card-image-wrapper">
               <img src="/terco-perolas-brancas.jpg" alt="Terços" />
            </div>
            <h3>Terços</h3>
          </a>

          <a href="/artigos" class="collection-card">
            <div class="card-image-wrapper">
               <img src="/leque-sagrado.jpg" alt="Artigos" />
            </div>
            <h3>Artigos</h3>
          </a>

          <a href="/camisetas" class="collection-card">
            <div class="card-image-wrapper">
               <img src="/camiseta.crista.jpg" alt="Camisetas" />
            </div>
            <h3>Camisetas</h3>
          </a>

          <a href="/estatuas" class="collection-card">
            <div class="card-image-wrapper">
              <img src="/a-sagrada-familia.jpg" alt="Estátuas" />
            </div>
            <h3>Estátuas</h3>
          </a>

        </div>
      </div>
    </section>
  </main>

  <WhatsAppButton />
</Layout>

<style>
  :root {
    --primary-green: #1f332a;
    --primary-green-light: #2d4a3e;
    --gold: #d4af37;
    --gold-dark: #b89728;
    --bg-light: #fbf9f4;
    --text-dark: #2c2c2c;
  }

  .featured-section {
    padding: 80px 20px;
    background-color: #fff;
    text-align: center;
  }
  .section-tag {
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
    margin-bottom: 8px;
    display: block;
  }
  .section-description {
    color: #666;
    margin-bottom: 50px;
    font-size: 15px;
  }
  .featured-section h2 {
    font-size: 36px;
    color: var(--primary-green);
    margin-bottom: 8px;
    font-weight: 700;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
    text-align: left;
    max-width: 1200px;
    margin: 0 auto;
  }

  .featured-image-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease;
  }

  .featured-image-link:hover {
    transform: translateY(-5px);
  }

  .hero-section {
    position: relative;
    color: #fff;
    text-align: center;
    padding: 140px 20px;
    overflow: hidden;
    background-color: var(--primary-green);
  }

  .hero-bg-collage {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    z-index: 1;
  }

  .hero-bg-item {
    flex: 1;
    max-width: 340px;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: blur(4px);
    transform: scale(1.05);
  }

  .bg-sagrada-familia { background-image: url('/a-sagrada-familia.jpg'); }
  .bg-cruz { background-image: url('/cruz-de-mesa.png'); }
  .bg-pulseira { background-image: url('/pulseira-terco.png'); }

  .hero-section::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(31, 51, 42, 0.85), rgba(31, 51, 42, 0.95));
    z-index: 2;
  }

  .hero-container {
    position: relative;
    z-index: 3;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-subtitle {
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 15px;
    display: block;
    font-weight: 700;
  }
  .hero-section h1 {
    font-size: 52px;
    margin-bottom: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }
  .hero-section p {
    font-size: 18px;
    margin-bottom: 35px;
    opacity: 0.9;
    font-weight: 300;
    line-height: 1.6;
  }
  
  .hero-actions {
    display: flex;
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  .btn-hero {
    display: inline-block;
    background-color: var(--gold);
    color: #fff;
    padding: 15px 35px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
  }
  .btn-hero:hover {
    background-color: var(--gold-dark);
    transform: translateY(-2px);
  }

  .btn-hero-outline {
    display: inline-block;
    background-color: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.3);
    padding: 13px 30px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
  }
  .btn-hero-outline:hover {
    border-color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .benefits-bar {
    background-color: #fff;
    border-bottom: 1px solid #eae1d0;
    padding: 30px 20px;
    position: relative;
    z-index: 5;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }
  .benefits-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }
  .benefit-item {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .benefit-icon {
    font-size: 32px;
    background: var(--bg-light);
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  .benefit-item h4 {
    font-size: 15px;
    color: var(--primary-green);
    margin-bottom: 4px;
    font-weight: 700;
  }
  .benefit-item p {
    font-size: 13px;
    color: #666;
  }

  .collections-section {
    padding: 80px 20px;
    background-color: var(--bg-light);
    text-align: center;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .collections-section h2 {
    font-size: 36px;
    color: var(--primary-green);
    margin-bottom: 50px;
    font-weight: 700;
  }
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 30px;
    justify-content: center;
  }
  .collection-card {
    background: #fff;
    padding: 25px 20px;
    border-radius: 16px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    display: block;
    border: 1px solid rgba(0,0,0,0.04);
  }
  .collection-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    border-color: var(--gold);
  }
  .card-image-wrapper {
    width: 110px;
    height: 110px;
    margin: 0 auto 18px auto;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--gold);
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  }
  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .collection-card:hover .card-image-wrapper img {
    transform: scale(1.1);
  }
  .collection-card h3 {
    font-size: 16px;
    color: var(--primary-green);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-section h1 { font-size: 36px; }
    .hero-actions { flex-direction: column; width: 100%; }
    .btn-hero, .btn-hero-outline { width: 100%; text-align: center; }
  }
</style>