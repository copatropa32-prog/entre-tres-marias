<Layout title="Terços | Entre Ave-Marias">
  <main class="catalog-page">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Início</a> &gt; <span>Terços</span>
      </div>

      <div class="page-header">
        <h1>Terços e Escapulários</h1>
        <p>Símbolos sagrados de proteção e oração para acompanhar a sua jornada espiritual.</p>
      </div>

      <div class="products-grid">
        {tercos.map((terco) => {
          const whatsappMessage = encodeURIComponent(`Olá! Gostaria de encomendar o ${terco.nome}. Poderia me informar valores, disponibilidade e formas de envio?`);
          return (
            <div class="product-card">
              <div class="product-image-wrapper">
                <button 
                  type="button" 
                  class="btn-favorite" 
                  data-id={terco.id}
                  data-name={terco.nome}
                  data-price={terco.preco}
                  data-image={terco.imagem}
                  aria-label="Adicionar aos favoritos"
                >
                  ❤️
                </button>

                <div class="clickable-img" data-img={terco.imagem} style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                  <img src={terco.imagem} alt={terco.nome} />
                  <span class="zoom-hint">🔍 Clique para ampliar</span>
                </div>
              </div>

              <div class="product-info">
                <div>
                  <h2>{terco.nome}</h2>
                  <p class="product-price">R$ {terco.preco.toFixed(2)}</p>
                  <p class="product-description" style="white-space: pre-line;">{terco.descricao}</p>
                  
                  <p class="section-title">Detalhes do produto:</p>
                  <ul class="product-details">
                    {(terco.detalhes || []).map((detalhe) => (
                      <li>{detalhe}</li>
                    ))}
                  </ul>

                  <p class="product-gift" style="white-space: pre-line;">{terco.sugestao}</p>
                </div>

                <div class="product-actions">
                  <button 
                    type="button" 
                    class="btn-cart"
                    onclick={`window.addToCart({
                      id: '${terco.id}',
                      name: '${terco.nome.replace(/'/g, "\\'")}',
                      price: ${terco.preco},
                      image: '${terco.imagem}'
                    })`}
                  >
                    Adicionar ao Carrinho 🛒
                  </button>

                  <a 
                    href={`https://wa.me/5511932189878?text=${whatsappMessage}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn-order"
                  >
                    Fazer Encomenda
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="other-collections">
        <h2>Explore Outras Coleções</h2>
        <div class="collections-links">
          <a href="/artigos">🎨 Artigos</a>
          <a href="/camisetas">👕 Camisetas</a>
          <a href="/estatuas">🏛️ Estátuas</a>
          <a href="/velas">🕯️ Velas</a>
        </div>
      </div>
    </div>
  </main>

  <div id="imageModal" class="modal">
    <span class="close-modal">&times;</span>
    <img class="modal-content" id="img01" alt="Imagem ampliada" />
  </div>

  <WhatsAppButton />
</Layout>

<script>
  window.addToCart = window.handleAddToCart = function(product) {
    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem('cart') || '[]');
    } catch (e) {
      cart = [];
    }

    const existingIndex = cart.findIndex(item => item.id === product.id);
    if (existingIndex > -1) {
      cart[existingIndex].quantity = (Number(cart[existingIndex].quantity) || 1) + 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }

    localStorage.setItem('cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-updated'));
  };
</script>