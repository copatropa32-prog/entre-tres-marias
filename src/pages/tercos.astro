<Layout title="Terços e Pulseiras | Entre Ave-Marias">
  <main class="catalog-page">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Início</a> &gt; <span>Terços e Pulseiras</span>
      </div>

      <div class="page-header">
        <h1>Terços e Pulseiras</h1>
        <p>Peças exclusivas e feitas à mão para acompanhar os seus momentos de fé e oração.</p>
      </div>

      <div class="products-grid">
        {tercos.map((terco) => {
          const whatsappMessage = encodeURIComponent(`Olá! Gostaria de fazer minha encomenda do produto ${terco.nome}. Poderia me informar disponibilidade e formas de envio?`);
          return (
            <div class="product-card">
              <div class="product-image-wrapper">
                <div class="clickable-img" data-img={terco.imagem}>
                  <img src={terco.imagem} alt={terco.nome} />
                  <span class="zoom-hint">🔍 Clique para ampliar</span>
                </div>
              </div>

              <div class="product-info">
                <div>
                  <h2>{terco.nome}</h2>
                  <p class="product-price">R$ {terco.preco.toFixed(2)}</p>
                  <p class="product-description" style="white-space: pre-line;">{terco.descricao}</p>
                  
                  <p class="section-title">Detalhes do produto:</p>
                  <ul class="product-details">
                    {(terco.detalhes || []).map((detalhe) => (
                      <li>{detalhe}</li>
                    ))}
                  </ul>

                  <p class="product-gift" style="white-space: pre-line;">{terco.sugestao}</p>
                </div>

                <div class="product-actions">
                  <button 
                    type="button" 
                    class="btn-cart"
                    onclick={`window.handleAddToCart({
                      id: '${terco.id}',
                      name: '${terco.nome.replace(/'/g, "\\'")}',
                      price: ${terco.preco},
                      image: '${terco.imagem}'
                    })`}
                  >
                    Adicionar ao Carrinho 🛒
                  </button>

                  <a 
                    href={`https://wa.me/5511932189878?text=${whatsappMessage}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn-order"
                  >
                    Encomendar via WhatsApp
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Seção de navegação rápida para outras coleções ao final dos cards -->
      <div class="other-collections-section">
        <h3>Explore Outras Coleções</h3>
        <div class="collections-quick-grid">
          <a href="/artigos" class="collection-quick-card">🎨 Artigos</a>
          <a href="/camisetas" class="collection-quick-card">👕 Camisetas</a>
          <a href="/estatuas" class="collection-quick-card">🏛️ Estátuas</a>
          <a href="/velas" class="collection-quick-card">🕯️ Velas</a>
        </div>
      </div>
    </div>
  </main>

  <div id="imageModal" class="modal">
    <span class="close-modal">&times;</span>
    <img class="modal-content" id="img01" alt="Imagem ampliada" />
  </div>

  <WhatsAppButton />
</Layout>

<script define:vars={{ tercosJson }}>
  const allProducts = JSON.parse(tercosJson);

  window.handleAddToCart = (product) => {
    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem('cart') || '[]');
    } catch (e) {
      cart = [];
    }

    const existingIndex = cart.findIndex(item => item.id === product.id);
    if (existingIndex > -1) {
      cart[existingIndex].quantity = (Number(cart[existingIndex].quantity) || 1) + 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }

    localStorage.setItem('cart', JSON.stringify(cart));
    
    if (typeof window.updateCartUI === 'function') {
      window.updateCartUI();
    }
    
    document.getElementById('cart-drawer')?.classList.add('open');
    document.getElementById('drawer-overlay')?.classList.add('open');
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('img01');
    const closeBtn = document.getElementsByClassName('close-modal')[0];
    const clickableImages = document.querySelectorAll('.clickable-img');

    clickableImages.forEach((wrapper) => {
      wrapper.addEventListener('click', () => {
        const imgSrc = wrapper.getAttribute('data-img');
        if (modal && modalImg && imgSrc) {
          modal.style.display = 'flex';
          modalImg.src = imgSrc;
        }
      });
    });

    if (closeBtn && modal) {
      closeBtn.onclick = () => {
        modal.style.display = 'none';
      };
    }

    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) {
          modal.style.display = 'none';
        }
      };
    }
  });
</script>

