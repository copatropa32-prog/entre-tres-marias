// Componente CartDrawer.astro - Centraliza Carrinho, Favoritos e Funções Globais
---

<div id="cart-drawer" class="side-drawer">
  <div class="drawer-header">
    <h3>🛒 Seu Carrinho</h3>
    <button class="close-drawer" onclick="document.getElementById('cart-drawer').classList.remove('open'); document.getElementById('drawer-overlay').classList.remove('open');">&times;</button>
  </div>
  <div class="drawer-body" id="cart-items-container">
    <p class="empty-msg">Seu carrinho está vazio.</p>
  </div>
  <div class="drawer-footer">
    <div class="subtotal-row">
      <span>Subtotal:</span>
      <strong id="cart-subtotal">R$ 0,00</strong>
    </div>
    <button class="btn-checkout" type="button" onclick="window.executarCheckoutWhatsApp()">Finalizar Pedido via WhatsApp</button>
  </div>
</div>

<div id="favorites-drawer" class="side-drawer">
  <div class="drawer-header">
    <h3>❤️ Meus Favoritos</h3>
    <button class="close-drawer" onclick="document.getElementById('favorites-drawer').classList.remove('open'); document.getElementById('drawer-overlay').classList.remove('open');">&times;</button>
  </div>
  <div class="drawer-body" id="favorites-items-container">
    <p class="empty-msg">Nenhum favorito salvo ainda.</p>
  </div>
</div>

<div id="drawer-overlay" class="drawer-overlay" onclick="document.querySelectorAll('.side-drawer').forEach(d => d.classList.remove('open')); this.classList.remove('open');"></div>

<script is:inline>
  window.executarCheckoutWhatsApp = function() {
    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem('cart') || '[]');
    } catch (e) {
      cart = [];
    }

    if (!cart || cart.length === 0) {
      alert("Seu carrinho está vazio!");
      return;
    }

    const numeroWhatsApp = "5511932189878"; 
    let mensagem = "Olá! Gostaria de finalizar o seguinte pedido:\n\n";
    let subtotal = 0;

    cart.forEach(item => {
      const price = Number(item.price) || 0;
      const qty = Number(item.quantity) || 1;
      let totalItem = price * qty;
      subtotal += totalItem;
      mensagem += `• ${item.name || 'Produto'} (Qtd: ${qty}) - R$ ${totalItem.toFixed(2)}\n`;
    });

    mensagem += `\n*Subtotal:* R$ ${subtotal.toFixed(2)}`;

    const url = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensagem)}`;
    window.open(url, '_blank');
  }

  function getCart() {
    try {
      return JSON.parse(localStorage.getItem('cart') || '[]');
    } catch (e) {
      return [];
    }
  }

  function saveCart(cart) {
    localStorage.setItem('cart', JSON.stringify(cart));
    window.updateCartUI();
  }

  function getFavorites() {
    try {
      return JSON.parse(localStorage.getItem('favorites') || '[]');
    } catch (e) {
      return [];
    }
  }

  function saveFavorites(favs) {
    localStorage.setItem('favorites', JSON.stringify(favs));
    window.updateFavoritesUI();
    window.syncFavoriteButtons();
    window.dispatchEvent(new CustomEvent('favoritesUpdated'));
  }

  window.updateCartUI = function() {
    const cart = getCart();
    const container = document.getElementById('cart-items-container');
    const subtotalEl = document.getElementById('cart-subtotal');
    const countNums = document.querySelectorAll('.cart-count-num');
    const totalItems = cart.reduce((sum, item) => sum + (Number(item.quantity) || 1), 0);
    
    countNums.forEach(el => el.textContent = totalItems);

    if (!container) return;

    if (!cart || cart.length === 0) {
      container.innerHTML = '<p class="empty-msg">Seu carrinho está vazio.</p>';
      if (subtotalEl) subtotalEl.textContent = 'R$ 0,00';
      return;
    }

    let subtotal = 0;
    container.innerHTML = cart.map((item) => {
      const price = Number(item.price) || 0;
      const qty = Number(item.quantity) || 1;
      subtotal += price * qty;
      const itemId = item.id || '';
      return `
        <div class="cart-row-item" data-id="${itemId}">
          <img src="${item.image || ''}" alt="${item.name || 'Produto'}" class="cart-thumb-img" />
          <div class="cart-info-col">
            <h4 class="cart-title-text">${item.name || 'Produto'}</h4>
            <span class="cart-price-text">R$ ${price.toFixed(2)} x ${qty}</span>
          </div>
          <button class="cart-del-btn" onclick="window.removeCartItemById('${itemId}')" type="button">&times;</button>
        </div>
      `;
    }).join('');

    if (subtotalEl) subtotalEl.textContent = `R$ ${subtotal.toFixed(2)}`;
  }

  window.addToCart = function(product) {
    let cart = getCart();
    const existingIndex = cart.findIndex(item => item.id === product.id);
    if (existingIndex > -1) {
      cart[existingIndex].quantity = (Number(cart[existingIndex].quantity) || 1) + 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }
    saveCart(cart);
    document.getElementById('cart-drawer')?.classList.add('open');
    document.getElementById('drawer-overlay')?.classList.add('open');
  };

  window.removeCartItemById = function(id) {
    let cart = getCart();
    cart = cart.filter(item => item.id !== id);
    saveCart(cart);
  };

  window.toggleFavorite = function(product) {
    let favs = getFavorites();
    const index = favs.findIndex(item => item.id === product.id);
    if (index > -1) { 
      favs.splice(index, 1); 
    } else { 
      favs.push(product); 
    }
    saveFavorites(favs);
  };

  window.updateFavoritesUI = function() {
    const favs = getFavorites();
    const container = document.getElementById('favorites-items-container');
    const favCountNums = document.querySelectorAll('.favorites-count-num');
    
    favCountNums.forEach(el => el.textContent = favs.length);

    if (!container) return;

    if (favs.length === 0) {
      container.innerHTML = '<p class="empty-msg">Nenhum favorito salvo ainda.</p>';
    } else {
      container.innerHTML = favs.map((item) => `
        <div class="cart-row-item" data-id="${item.id}">
          <img src="${item.image || ''}" alt="${item.name || 'Produto'}" class="cart-thumb-img" />
          <div class="cart-info-col">
            <h4 class="cart-title-text">${item.name || 'Produto'}</h4>
            <span class="cart-price-text">R$ ${Number(item.price || 0).toFixed(2)}</span>
          </div>
          <button class="cart-del-btn" onclick="window.removeFavoriteById('${item.id}')" type="button">&times;</button>
        </div>
      `).join('');
    }
  }

  window.removeFavoriteById = function(id) {
    let favs = getFavorites();
    favs = favs.filter(item => item.id !== id);
    saveFavorites(favs);
  };

  window.syncFavoriteButtons = function() {
    try {
      const favs = getFavorites();
      document.querySelectorAll('.btn-favorite').forEach(btn => {
        const id = btn.getAttribute('data-id');
        const isFav = favs.some(fav => fav.id === id);
        if (isFav) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    } catch (e) {
      console.error('Erro ao sincronizar favoritos:', e);
    }
  };

  // Delegação global de cliques para botões de favoritos
  document.addEventListener('click', (e) => {
    const favBtn = e.target.closest('.btn-favorite');
    if (favBtn) {
      e.preventDefault();
      const product = {
        id: favBtn.getAttribute('data-id'),
        name: favBtn.getAttribute('data-name'),
        price: Number(favBtn.getAttribute('data-price')),
        image: favBtn.getAttribute('data-image')
      };
      if (product.id) {
        window.toggleFavorite(product);
      }
    }
  });

  function initDrawers() {
    window.updateCartUI();
    window.updateFavoritesUI();
    window.syncFavoriteButtons();

    document.querySelectorAll('#open-cart-desktop, #open-cart-mobile, #open-cart-mobile-menu').forEach(el => {
      el?.addEventListener('click', () => {
        document.getElementById('cart-drawer')?.classList.add('open');
        document.getElementById('drawer-overlay')?.classList.add('open');
      });
    });
    document.querySelectorAll('#open-favorites-desktop, #open-favorites-mobile-menu').forEach(el => {
      el?.addEventListener('click', () => {
        document.getElementById('favorites-drawer')?.classList.add('open');
        document.getElementById('drawer-overlay')?.classList.add('open');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDrawers);
  document.addEventListener('astro:page-load', initDrawers);
</script>

<style is:global>
  .side-drawer { 
    position: fixed; top: 0; right: -400px; width: 380px; height: 100vh; 
    background: #ffffff; box-shadow: -5px 0 25px rgba(0,0,0,0.15); 
    z-index: 1000000; display: flex; flex-direction: column; 
    transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1); 
  }
  .side-drawer.open { right: 0; }
  
  .drawer-header { 
    background: #2d4a3e; color: #fff; padding: 18px 20px; 
    display: flex; justify-content: space-between; align-items: center; 
  }
  .drawer-header h3 { margin: 0; font-size: 16px; font-weight: 600; }
  .close-drawer { background: none; border: none; color: #fff; font-size: 24px; cursor: pointer; }

  .drawer-body { flex: 1; padding: 20px; overflow-y: auto; }
  .empty-msg { color: #666; text-align: center; margin-top: 40px; font-size: 14px; }

  .cart-row-item {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding-bottom: 12px !important;
    margin-bottom: 12px !important;
    border-bottom: 1px solid #eee !important;
  }

  .cart-thumb-img {
    width: 60px !important;
    height: 60px !important;
    min-width: 60px !important;
    max-width: 60px !important;
    min-height: 60px !important;
    max-height: 60px !important;
    object-fit: cover !important;
    border-radius: 6px !important;
    border: 1px solid #ddd !important;
    display: block !important;
    flex-shrink: 0 !important;
  }

  .cart-info-col {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
  }

  .cart-title-text {
    font-size: 13px !important;
    margin: 0 !important;
    color: #2d4a3e !important;
    line-height: 1.3 !important;
    font-weight: 500 !important;
  }

  .cart-price-text {
    font-size: 13px !important;
    color: #666 !important;
    font-weight: 600!important;
  }

  .cart-del-btn {
    background: none !important;
    border: none !important;
    color: #991b1b !important;
    cursor: pointer !important;
    font-size: 18px !important;
    padding: 4px 8px !important;
  }

  .drawer-footer { padding: 20px; border-top: 1px solid #eae1d0; background: #fbf9f4; }
  .subtotal-row { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 15px; color: #2d4a3e; font-weight: 600; }
  
  .btn-checkout { 
    display: block; width: 100%; background: #d4af37; color: #fff; 
    text-align: center; padding: 12px; border-radius: 6px; text-decoration: none; 
    font-weight: bold; font-size: 14px; border: none; cursor: pointer;
  }
  .btn-checkout:hover { background: #c19b2e; }

  .drawer-overlay { 
    position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
    background: rgba(0,0,0,0.5); visibility: hidden; opacity: 0; 
    transition: opacity 0.3s; z-index: 999990; 
  }
  .drawer-overlay.open { visibility: visible; opacity: 1; }
</style>