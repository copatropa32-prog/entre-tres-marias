---
<!-- Gaveta do Carrinho -->
<div id="cart-drawer" class="side-drawer">
  <div class="drawer-header">
    <h3>🛒 Seu Carrinho</h3>
    <button type="button" class="close-drawer" onclick="document.getElementById('cart-drawer').classList.remove('open')">&times;</button>
  </div>
  <div class="drawer-body" id="cart-items-container">
    <!-- Itens injetados via JS -->
  </div>
  <div class="drawer-footer">
    <div class="subtotal-row">
      <span>Subtotal:</span>
      <strong id="cart-subtotal">R$ 0,00</strong>
    </div>
    <a href="/checkout" class="btn-checkout">Finalizar Pedido</a>
  </div>
</div>

<!-- Gaveta de Favoritos -->
<div id="favorites-drawer" class="side-drawer">
  <div class="drawer-header">
    <h3>❤️ Meus Favoritos</h3>
    <button type="button" class="close-drawer" onclick="document.getElementById('favorites-drawer').classList.remove('open')">&times;</button>
  </div>
  <div class="drawer-body" id="favorites-items-container">
    <p class="empty-msg">Nenhum favorito salvo ainda.</p>
  </div>
</div>

<div id="drawer-overlay" class="drawer-overlay" onclick="document.querySelectorAll('.side-drawer').forEach(d => d.classList.remove('open'))"></div>

<style>
  .side-drawer {
    position: fixed;
    top: 0;
    right: -400px;
    width: 380px;
    height: 100vh;
    background: #ffffff;
    box-shadow: -5px 0 25px rgba(0,0,0,0.15);
    z-index: 1000000;
    display: flex;
    flex-direction: column;
    transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .side-drawer.open { right: 0; }
  
  .drawer-header {
    background: #2d4a3e;
    color: #fff;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .drawer-header h3 { margin: 0; font-size: 16px; }
  .close-drawer { background: none; border: none; color: #fff; font-size: 24px; cursor: pointer; }

  .drawer-body { flex: 1; padding: 20px; overflow-y: auto; }
  .empty-msg { color: #666; text-align: center; margin-top: 40px; font-size: 14px; }

  .drawer-footer { padding: 20px; border-top: 1px solid #eae1d0; background: #fbf9f4; }
  .subtotal-row { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 15px; color: #2d4a3e; }
  
  .btn-checkout {
    display: block;
    width: 100%;
    background: #d4af37;
    color: #fff;
    text-align: center;
    padding: 12px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    transition: background 0.2s;
  }
  .btn-checkout:hover { background: #c19b2e; }

  .drawer-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    visibility: hidden; opacity: 0;
    transition: opacity 0.3s;
    z-index: 999990;
  }
  /* Exibe overlay se alguma gaveta estiver aberta */
  /* (Pode ser controlado via classe no body ou JS, mas mantemos simples) */
</style>