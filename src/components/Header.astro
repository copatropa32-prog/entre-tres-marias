  .user-text .bottom-txt { font-size: 10px; color: #666; }

  /* Nav Menu / Menu Lateral Mobile */
  .nav-menu {
    position: fixed;
    top: 0;
    left: -300px;
    width: 280px;
    height: 100vh;
    background: #fff;
    box-shadow: 4px 0 20px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
