  }

  @media(min-width: 768px) {
    .menu-section-label { display: none; }
    .mobile-extra-links { display: contents; }
    .mobile-extra-links a { color: #2d4a3e; font-size: 13px; padding: 5px 10px; border: none; }

    .nav-menu {
      position: static;
      height: auto;
