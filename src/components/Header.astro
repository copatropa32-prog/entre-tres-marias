  .top-bar { background: #d4af37; color: #fff; font-size: 12px; display: flex; justify-content: space-between; padding: 6px 40px; }
  .top-links { display: flex; gap: 15px; align-items: center; }
  .top-links a { color: #fff; text-decoration: none; }
  .main-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 40px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo img { width: 50px; height: 50px; border-radius: 50%; object-fit: contain; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo-text span { font-size: 11px; color: #555; letter-spacing: 1px; }
  .logo-text .brand { font-size: 16px; font-weight: bold; color: #2d4a3e; }
  .logo-text .sub { font-size: 9px; color: #888; }
  .search-bar { display: flex; border: 1px solid #ddd; border-radius: 20px; overflow: hidden; width: 350px; }
  .search-bar input { width: 100%; border: none; padding: 8px 15px; outline: none; font-size: 13px; }
  .search-bar button { background: #fff; border: none; padding: 0 12px; cursor: pointer; }
  .user-action-box { display: flex; align-items: center; }
  .user-box-link { display: flex; align-items: center; gap: 10px; text-decoration: none; border: 1px solid #eae1d0; padding: 8px 15px; border-radius: 30px; }
  .user-icon { font-size: 20px; color: #2d4a3e; }
  .user-text { display: flex; flex-direction: column; }
  .user-text .top-txt { font-size: 13px; font-weight: bold; color: #2d4a3e; }
  .user-text .bottom-txt { font-size: 11px; color: #666; }
  .nav-menu { display: flex; justify-content: center; gap: 25px; padding: 10px 0; border-top: 1px solid #f2eedb; background: #fff; flex-wrap: wrap; }
  .nav-menu a { text-decoration: none; font-size: 13px; font-weight: bold; color: #2d4a3e; padding: 5px 10px; }
  .nav-menu a:hover { color: #d4af37; }
</style>