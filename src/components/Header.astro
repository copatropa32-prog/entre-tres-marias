<header class="header">
  <div class="top-bar">
    <span>✨ Frete grátis para São Bernardo do Campo nas compras acima de R$ 150</span>
    <div class="top-links">
      <a href="/envio">Rastrear pedido</a>
      <a href="/favoritos">Favoritos</a>
      <a href="/carrinho">Meu carrinho (0)</a>
      
      <!-- Área dinamicamente controlada pelo JS -->
      <div id="user-menu" style="display: inline-block; margin-left: 15px;">
        <a href="/login" id="auth-link" class="login-btn">Entrar</a>
      </div>
    </div>
  </div>

  <div class="main-header">
    <a href="/" class="logo">
      <img src="/logotipo.png" alt="Entre Ave-Marias" />
      <div class="logo-text">
        <span>Entre</span>
        <span class="brand">Ave-Marias</span>
        <span class="sub">artigos religiosos</span>
      </div>
    </a>

    <div class="search-bar">
      <input type="text" placeholder="Faça uma pesquisa..." />
      <button><i class="search-icon">🔍</i></button>
    </div>

    <div class="user-action-box">
      <a href="/login" id="header-user-action" class="user-box-link">
        <div class="user-icon">👤</div>
        <div class="user-text">
          <span class="top-txt">Cadastre-se</span>
          <span class="bottom-txt">para uma compra rápida!</span>
        </div>
      </a>
    </div>
  </div>

  <nav class="nav-menu">
    <a href="/">INÍCIO</a>
    <a href="/sobre">QUEM SOMOS</a>
    <a href="/envio">FORMAS DE ENVIO</a>
    <a href="/tercos">TERÇOS</a>
    <a href="/artigos">ARTIGOS</a>
    <a href="/camisetas">CAMISETAS</a>
    <a href="/estatuas">ESTÁTUAS</a>
    <a href="/velas">VELAS</a>
  </nav>
</header>

<script>
  import { supabase } from '../lib/supabase';

  async function checkUser() {
    const { data: { session } } = await supabase.auth.getSession();
    
    const authLink = document.getElementById('auth-link');
    const headerUserAction = document.getElementById('header-user-action');

    if (session && session.user) {
      const email = session.user.email;
      
      // Atualiza o botão superior "Entrar" para mostrar o e-mail e opção de Sair
      if (authLink) {
        authLink.textContent = email;
        authLink.setAttribute('href', '#');
        authLink.style.background = '#d4af37';
        authLink.style.color = '#fff';
        authLink.style.padding = '4px 10px';
        authLink.style.borderRadius = '4px';
        
        authLink.addEventListener('click', async (e) => {
          e.preventDefault();
          if (confirm('Deseja sair da sua conta?')) {
            await supabase.auth.signOut();
            window.location.href = '/';
          }
        });
      }

      // Atualiza o bloco lateral direito
      if (headerUserAction) {
        headerUserAction.setAttribute('href', '#');
        const bottomTxt = headerUserAction.querySelector('.bottom-txt');
        const topTxt = headerUserAction.querySelector('.top-txt');
        if (topTxt) topTxt.textContent = 'Olá, bem-vindo(a)!';
        if (bottomTxt) bottomTxt.textContent = 'Clique para Sair';
        
        headerUserAction.addEventListener('click', async (e) => {
          e.preventDefault();
          await supabase.auth.signOut();
          window.location.href = '/';
        });
      }
    }
  }

  checkUser();
</script>

<style>
