---
import { supabase } from '../lib/supabase';
---

<header class="header">
  <!-- Top Bar (Desktop) -->
  <div class="top-bar">
    <span>✨ Frete grátis para São Bernardo do Campo nas compras acima de R$ 150</span>
    <div class="top-links">
      <a href="/envio">Rastrear pedido</a>
      <!-- Botão Favoritos (Desktop Topo) -->
      <button type="button" class="link-btn" id="open-wishlist-desktop">❤️ Favoritos (<span class="wishlist-count-num">0</span>)</button>
      <button type="button" class="link-btn" id="open-cart-desktop">Meu carrinho (<span class="cart-count-num">0</span>)</button>
      <div id="user-menu-desktop" class="user-desktop-wrapper">
        <a href="/login" id="auth-link-desktop" class="login-btn">Entrar</a>
      </div>
    </div>
  </div>

  <!-- Checkbox invisível que controla a abertura do menu mobile -->
  <input type="checkbox" id="menu-checkbox" class="menu-checkbox" />

  <!-- Main Header -->
  <div class="main-header">
    <div class="header-left">
      <!-- Botão Hambúrguer conectado ao Checkbox -->
      <label for="menu-checkbox" class="menu-toggle" aria-label="Abrir Menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </label>

      <a href="/" class="logo">
        <img src="/logotipo.png" alt="Entre Ave-Marias" />
        <div class="logo-text">
          <span>Entre</span>
          <span class="brand">Ave-Marias</span>
          <span class="sub">artigos religiosos</span>
        </div>
      </a>
    </div>

    <!-- Barra de pesquisa -->
    <div class="search-bar">
      <input type="text" placeholder="Pesquisar artigos sagrados, terços..." />
      <button type="button" aria-label="Pesquisar"><i class="search-icon">🔍</i></button>
    </div>

    <div class="header-right-actions">
      <!-- Ícone de Favoritos para Mobile -->
      <button type="button" class="mobile-icon-btn" id="open-wishlist-mobile" title="Favoritos">
        ❤️ <span class="badge-count wishlist-count-num">0</span>
      </button>

      <!-- Ícone de Carrinho para Mobile -->
      <button type="button" class="mobile-cart-icon" id="open-cart-mobile" title="Carrinho">
        🛒 <span class="cart-count cart-count-num">0</span>
      </button>

      <!-- Bloco de Usuário (Desktop) -->
      <div class="user-action-box">
        <a href="/login" id="header-user-action" class="user-box-link">
          <div class="user-icon">👤</div>
          <div class="user-text">
            <span class="top-txt">Cadastre-se</span>
            <span class="bottom-txt">para compra rápida!</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Menu de Navegação / Gaveta Lateral Mobile -->
  <nav class="nav-menu" id="navMenu">
    <div class="mobile-menu-header">
      <div class="mobile-menu-title">
        <span>Entre Ave-Marias</span>
        <small>Artigos Religiosos</small>
      </div>
      <label for="menu-checkbox" class="close-menu" aria-label="Fechar Menu">&times;</label>
    </div>
    
    <!-- Categorias Principais -->
    <div class="menu-section-label">Navegação</div>
    <a href="/">🏠 Início</a>
    <a href="/sobre">🕊️ Quem Somos</a>
    <a href="/envio">🚚 Formas de Envio</a>

    <div class="menu-section-label">Coleções</div>
    <a href="/tercos">📿 Terços</a>
    <a href="/artigos">🕯️ Artigos Sagrados</a>
    <a href="/camisetas">👕 Camisetas</a>
    <a href="/estatuas">🗿 Estátuas</a>
    <a href="/velas">🕯️ Velas</a>

    <!-- Links de Conta e Ajuda no Mobile -->
    <div class="menu-section-label">Minha Conta & Pedidos</div>
    <div class="mobile-extra-links">
      <button type="button" class="menu-link-item" id="open-wishlist-mobile-menu">❤️ Meus Favoritos (<span class="wishlist-count-num">0</span>)</button>
      <button type="button" class="menu-link-item" id="open-cart-mobile-menu">🛒 Meu Carrinho (<span class="cart-count-num">0</span>)</button>
      <a href="/envio">📦 Rastrear Pedido</a>
      <a href="/login" id="auth-link-mobile" class="mobile-login-highlight">👤 Entrar / Cadastrar</a>
    </div>
  </nav>
  
  <!-- Overlay escuro clicável para fechar -->
  <label for="menu-checkbox" class="menu-overlay"></label>
</header>

<script>
  import { supabase } from '../lib/supabase';

  async function checkUser() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      
      const authLinkDesktop = document.getElementById('auth-link-desktop');
      const authLinkMobile = document.getElementById('auth-link-mobile');
      const headerUserAction = document.getElementById('header-user-action');

      if (session && session.user) {
        const email = session.user.email;
        
        if (authLinkDesktop) {
          authLinkDesktop.textContent = email;
          authLinkDesktop.setAttribute('href', '#');
          authLinkDesktop.className = 'user-logged-badge';
          authLinkDesktop.onclick = async (e) => {
            e.preventDefault();
            if (confirm('Deseja sair da sua conta?')) {
              await supabase.auth.signOut();
              window.location.href = '/';
            }
          };
        }

        if (authLinkMobile) {
          authLinkMobile.textContent = `Sair da Conta (${email})`;
          authLinkMobile.className = 'mobile-login-highlight logout-style';
          authLinkMobile.onclick = async (e) => {
            e.preventDefault();
            if (confirm('Deseja sair da sua conta?')) {
              await supabase.auth.signOut();
              window.location.href = '/';
            }
          };
        }

        if (headerUserAction) {
          headerUserAction.setAttribute('href', '#');
          const topTxt = headerUserAction.querySelector('.top-txt');
          const bottomTxt = headerUserAction.querySelector('.bottom-txt');
          if (topTxt) topTxt.textContent = 'Olá, Bem-vindo(a)!';
          if (bottomTxt) bottomTxt.textContent = 'Clique para Sair';
          
          headerUserAction.onclick = async (e) => {
            e.preventDefault();
            if (confirm('Deseja sair da sua conta?')) {
              await supabase.auth.signOut();
              window.location.href = '/';
            }
          };
        }
      }
    } catch (err) {
      console.error("Erro ao checar sessão:", err);
    }
  }

  document.addEventListener('DOMContentLoaded', checkUser);
  document.addEventListener('astro:page-load', checkUser);
</script>

<style>
  .header {
    background: #ffffff;
    border-bottom: 1px solid #eae1d0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    position: sticky;
    top: 0;
    z-index: 99999;
  }
  
  .menu-checkbox { display: none; }

  .top-bar {
    background: #2d4a3e;
    color: #fcfbfa;
    font-size: 12px;
    display: none;
    justify-content: space-between;
    align-items: center;
    padding: 8px 40px;
    letter-spacing: 0.3px;
  }
  @media(min-width: 768px) {
    .top-bar { display: flex; }
  }
  .top-links { display: flex; gap: 20px; align-items: center; }
  .top-links a, .link-btn { color: #fcfbfa; text-decoration: none; background: none; border: none; font-size: 12px; cursor: pointer; padding: 0; font-family: inherit; transition: opacity 0.2s; }
  .top-links a:hover, .link-btn:hover { opacity: 0.8; text-decoration: underline; }
  .user-desktop-wrapper { display: inline-block; margin-left: 10px; }
  .user-logged-badge {
    background: #d4af37;
    color: #fff !important;
    padding: 4px 12px;
    border-radius: 4px;
    font-weight: 500;
  }

  .main-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: #ffffff;
    position: relative;
    z-index: 100010;
  }
  @media(min-width: 768px) {
    .main-header { padding: 15px 40px; }
  }

  .header-left { display: flex; align-items: center; gap: 16px; }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 36px;
    height: 28px;
    background: #fdfaf4;
    border: 1px solid #e3d7c3;
    border-radius: 6px;
    cursor: pointer;
    padding: 6px;
    z-index: 100020;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.2s;
  }
  .menu-toggle:hover { background: #f4ecdf; }
  .menu-toggle .bar {
    display: block;
    width: 100%;
    height: 3px;
    background-color: #2d4a3e;
    border-radius: 2px;
    pointer-events: none;
  }
  @media(min-width: 768px) {
    .menu-toggle { display: none; }
  }

  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid #d4af37; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.15; }
  .logo-text span { font-size: 10px; color: #666; letter-spacing: 1.2px; text-transform: uppercase; }
  .logo-text .brand { font-size: 16px; font-weight: 700; color: #2d4a3e; }
  .logo-text .sub { font-size: 9px; color: #888; display: none; }
  @media(min-width: 480px) {
    .logo img { width: 50px; height: 50px; }
    .logo-text .sub { display: block; }
  }

  .search-bar { display: none; border: 1px solid #dcd3c1; border-radius: 24px; overflow: hidden; width: 360px; background: #faf8f5; transition: border-color 0.2s; }
  .search-bar:focus-within { border-color: #2d4a3e; background: #fff; }
  @media(min-width: 768px) {
    .search-bar { display: flex; }
  }
  .search-bar input { width: 100%; border: none; padding: 10px 18px; outline: none; font-size: 13px; background: transparent; color: #333; }
  .search-bar button { background: transparent; border: none; padding: 0 16px; cursor: pointer; color: #2d4a3e; }

  .header-right-actions { display: flex; align-items: center; gap: 18px; }

  .mobile-icon-btn, .mobile-cart-icon {
    display: flex;
    align-items: center;
    background: none;
    border: none;
    text-decoration: none;
    font-size: 22px;
    position: relative;
    color: #2d4a3e;
    cursor: pointer;
  }
  .cart-count, .badge-count {
    font-size: 10px;
    background: #d4af37;
    color: #fff;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: -8px;
    right: -10px;
    font-weight: bold;
  }
  @media(min-width: 768px) {
    .mobile-icon-btn { display: none; }
    .mobile-cart-icon { display: none; }
  }

  .user-action-box { display: none; }
  @media(min-width: 768px) {
    .user-action-box { display: flex; align-items: center; }
  }
  .user-box-link { display: flex; align-items: center; gap: 10px; text-decoration: none; border: 1px solid #e3d7c3; padding: 6px 16px; border-radius: 30px; background: #faf8f5; transition: all 0.2s; }
  .user-box-link:hover { background: #f4ecdf; border-color: #d4af37; }
  .user-icon { font-size: 18px; color: #2d4a3e; }
  .user-text { display: flex; flex-direction: column; }
  .user-text .top-txt { font-size: 12px; font-weight: 700; color: #2d4a3e; }
  .user-text .bottom-txt { font-size: 10px; color: #666; }

  .nav-menu {
    position: fixed;
    top: 0;
    left: -320px;
    width: 300px;
    height: 100vh;
    background: #ffffff;
    box-shadow: 5px 0 25px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 999999;
    overflow-y: auto;
  }

  #menu-checkbox:checked ~ .nav-menu {
    left: 0;
  }

  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: #2d4a3e;
    color: #fff;
  }
  .mobile-menu-title span { display: block; font-weight: bold; font-size: 17px; }
  .mobile-menu-title small { font-size: 11px; opacity: 0.85; letter-spacing: 0.5px; }

  .close-menu {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #fff;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
  }
  .close-menu:hover { background: rgba(255, 255, 255, 0.2); }
  @media(min-width: 768px) {
    .mobile-menu-header { display: none; }
  }

  .menu-section-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #887a63;
    background: #fbf9f4;
    padding: 12px 20px;
    font-weight: 700;
    border-bottom: 1px solid #f2eedb;
    border-top: 1px solid #f2eedb;
    margin-top: 4px;
  }

  .nav-menu a, .menu-link-item {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    color: #2d4a3e;
    padding: 14px 20px;
    border-bottom: 1px solid #f4f0e6;
    display: block;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, color 0.2s;
  }
  .nav-menu a:hover, .menu-link-item:hover { color: #d4af37; background: #faf8f3; }

  .mobile-extra-links {
    display: flex;
    flex-direction: column;
  }
  .mobile-extra-links a, .mobile-extra-links .menu-link-item {
    color: #444;
    font-size: 13px;
  }
  .mobile-login-highlight {
    background: #fdf8eb;
    color: #2d4a3e !important;
    font-weight: 700 !important;
  }
  .logout-style {
    background: #fdf2f2 !important;
    color: #991b1b !important;
  }

  @media(min-width: 768px) {
    .nav-menu {
      display: none !important;
    }
  }

  .menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 999950;
    cursor: pointer;
  }

  #menu-checkbox:checked ~ .menu-overlay {
    visibility: visible;
    opacity: 1;
  }
</style>[cite: 12]