<header class="header">
  <!-- Top Bar (Desktop) -->
  <div class="top-bar">
    <span>✨ Frete grátis para São Bernardo do Campo nas compras acima de R$ 150</span>
    <div class="top-links">
      <a href="/envio">Rastrear pedido</a>
      <a href="/favoritos">Favoritos</a>
      <a href="/carrinho">Meu carrinho (0)</a>
      <div id="user-menu-desktop" class="user-desktop-wrapper">
        <a href="/login" id="auth-link-desktop" class="login-btn">Entrar</a>
      </div>
    </div>
  </div>

  <!-- Main Header -->
  <div class="main-header">
    <div class="header-left">
      <!-- Botão Hambúrguer Profissional -->
      <button class="menu-toggle" id="menuToggle" aria-label="Abrir Menu" type="button">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>

      <a href="/" class="logo">
        <img src="/logotipo.png" alt="Entre Ave-Marias" />
        <div class="logo-text">
          <span>Entre</span>
          <span class="brand">Ave-Marias</span>
          <span class="sub">artigos religiosos</span>
        </div>
      </a>
    </div>

    <!-- Barra de pesquisa -->
    <div class="search-bar">
      <input type="text" placeholder="Pesquisar artigos sagrados, terços..." />
      <button type="button" aria-label="Pesquisar"><i class="search-icon">🔍</i></button>
    </div>

    <div class="header-right-actions">
      <!-- Ícone de Carrinho para Mobile -->
      <a href="/carrinho" class="mobile-cart-icon" title="Carrinho">
        🛒 <span class="cart-count">0</span>
      </a>

      <!-- Bloco de Usuário (Desktop) -->
      <div class="user-action-box">
        <a href="/login" id="header-user-action" class="user-box-link">
          <div class="user-icon">👤</div>
          <div class="user-text">
            <span class="top-txt">Cadastre-se</span>
            <span class="bottom-txt">para compra rápida!</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Menu de Navegação / Gaveta Lateral Mobile -->
  <nav class="nav-menu" id="navMenu">
    <div class="mobile-menu-header">
      <div class="mobile-menu-title">
        <span>Entre Ave-Marias</span>
        <small>Artigos Religiosos</small>
      </div>
      <button class="close-menu" id="closeMenu" type="button" aria-label="Fechar Menu">&times;</button>
    </div>
    
    <!-- Categorias Principais -->
    <div class="menu-section-label">Navegação</div>
    <a href="/">🏠 Início</a>
    <a href="/sobre">🕊️ Quem Somos</a>
    <a href="/envio">🚚 Formas de Envio</a>

    <div class="menu-section-label">Coleções</div>
    <a href="/tercos">📿 Terços</a>
    <a href="/artigos">🕯️ Artigos Sagrados</a>
    <a href="/camisetas">👕 Camisetas</a>
    <a href="/estatuas">🗿 Estátuas</a>
    <a href="/velas">🕯️ Velas</a>

    <!-- Links de Conta e Ajuda no Mobile -->
    <div class="menu-section-label">Minha Conta & Pedidos</div>
    <div class="mobile-extra-links">
      <a href="/carrinho">🛒 Meu Carrinho (0)</a>
      <a href="/favoritos">❤️ Meus Favoritos</a>
      <a href="/envio">📦 Rastrear Pedido</a>
      <a href="/login" id="auth-link-mobile" class="mobile-login-highlight">👤 Entrar / Cadastrar</a>
    </div>
  </nav>
  
  <!-- Overlay escuro -->
  <div class="menu-overlay" id="menuOverlay"></div>
</header>

<script>
  import { supabase } from '../lib/supabase';

  function initHeader() {
    const menuToggle = document.getElementById('menuToggle');
    const closeMenu = document.getElementById('closeMenu');
    const navMenu = document.getElementById('navMenu');
    const menuOverlay = document.getElementById('menuOverlay');

    if (menuToggle && navMenu && menuOverlay) {
      // Remove eventuais duplicidades limpando clones anteriores se houver
      const newToggle = menuToggle.cloneNode(true);
      menuToggle.parentNode.replaceChild(newToggle, menuToggle);
      
      const freshToggle = document.getElementById('menuToggle');
      const freshClose = document.getElementById('closeMenu');
      const freshOverlay = document.getElementById('menuOverlay');

      const openDrawer = (e) => {
        e.preventDefault();
        e.stopPropagation();
        navMenu.classList.add('active');
        freshOverlay.classList.add('active');
        document.body.classList.add('no-scroll');
      };

      const closeDrawer = (e) => {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        navMenu.classList.remove('active');
        freshOverlay.classList.remove('active');
        document.body.classList.remove('no-scroll');
      };

      freshToggle.addEventListener('click', openDrawer);
      if (freshClose) freshClose.addEventListener('click', closeDrawer);
      freshOverlay.addEventListener('click', closeDrawer);

      // Fecha ao clicar em qualquer link do menu no celular
      navMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 768) {
            closeDrawer();
          }
        });
      });
    }

    // Gerenciamento de Sessão Supabase
    async function checkUser() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        
        const authLinkDesktop = document.getElementById('auth-link-desktop');
        const authLinkMobile = document.getElementById('auth-link-mobile');
        const headerUserAction = document.getElementById('header-user-action');

        if (session && session.user) {
          const email = session.user.email;
          
          if (authLinkDesktop) {
            authLinkDesktop.textContent = email;
            authLinkDesktop.setAttribute('href', '#');
            authLinkDesktop.className = 'user-logged-badge';
            authLinkDesktop.onclick = async (e) => {
              e.preventDefault();
              if (confirm('Deseja sair da sua conta?')) {
                await supabase.auth.signOut();
                window.location.href = '/';
              }
            };
          }

          if (authLinkMobile) {
            authLinkMobile.textContent = `Sair da Conta (${email})`;
            authLinkMobile.className = 'mobile-login-highlight logout-style';
            authLinkMobile.onclick = async (e) => {
              e.preventDefault();
              if (confirm('Deseja sair da sua conta?')) {
                await supabase.auth.signOut();
                window.location.href = '/';
              }
            };
          }

          if (headerUserAction) {
            headerUserAction.setAttribute('href', '#');
            const topTxt = headerUserAction.querySelector('.top-txt');
            const bottomTxt = headerUserAction.querySelector('.bottom-txt');
            if (topTxt) topTxt.textContent = 'Olá, Bem-vindo(a)!';
            if (bottomTxt) bottomTxt.textContent = 'Clique para Sair';
            
            headerUserAction.onclick = async (e) => {
              e.preventDefault();
              if (confirm('Deseja sair da sua conta?')) {
                await supabase.auth.signOut();
                window.location.href = '/';
              }
            };
          }
        }
      } catch (err) {
        console.error("Erro ao checar sessão:", err);
      }
    }

    checkUser();
  }

  // Executa no carregamento inicial e em transições de página do Astro
  document.addEventListener('DOMContentLoaded', initHeader);
  document.addEventListener('astro:page-load', initHeader);
</script>

