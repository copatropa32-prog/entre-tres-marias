---
// src/components/WishlistDrawer.astro
---

<div id="wishlist-drawer" class="wishlist-drawer-overlay">
  <div class="wishlist-drawer">
    <div class="wishlist-header">
      <h3>Meus Favoritos (<span id="wishlist-count">0</span>)</h3>
      <button id="close-wishlist" class="close-btn">&times;</button>
    </div>

    <div class="wishlist-body" id="wishlist-items-container">
      <p class="empty-wishlist">Sua lista de favoritos está vazia.</p>
    </div>

    <div class="wishlist-footer" id="wishlist-footer" style="display: none;">
      <button id="move-all-to-cart" class="btn-move-cart">
        🛒 Mover todos para o carrinho
      </button>
    </div>
  </div>
</div>

<style>
  .wishlist-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  .wishlist-drawer-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .wishlist-drawer {
    width: 100%;
    max-width: 400px;
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    box-shadow: -5px 0 25px rgba(0,0,0,0.1);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  .wishlist-drawer-overlay.open .wishlist-drawer {
    transform: translateX(0);
  }
  .wishlist-header {
    padding: 20px;
    border-bottom: 1px solid #eae1d0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #fbf9f4;
  }
  .wishlist-header h3 {
    font-size: 18px;
    color: #1f332a;
    font-weight: 700;
  }
  .close-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #2c2c2c;
  }
  .wishlist-body {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
  }
  .empty-wishlist {
    text-align: center;
    color: #666;
    margin-top: 40px;
    font-size: 14px;
  }
  .wishlist-footer {
    padding: 20px;
    border-top: 1px solid #eae1d0;
    background-color: #fbf9f4;
  }
  .btn-move-cart {
    width: 100%;
    background-color: #1f332a;
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .btn-move-cart:hover {
    background-color: #2d4a3e;
  }
</style>